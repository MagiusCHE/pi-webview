{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=magiusche.pi-webview-ide",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/extension/**/*.cjs"],
      "preLaunchTask": "build-extension"
    }
  ]
}
