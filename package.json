{
  "name": "pi-webview",
  "displayName": "pi-webview",
  "version": "0.1.12",
  "description": "WebView UI for the pi coding agent: standalone in the browser and inside VS Code",
  "publisher": "magiusche",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagiusCHE/pi-webview"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0",
    "vscode": "^1.90.0"
  },
  "main": "dist/extension/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:piWebview",
    "onCommand:pi-webview.newChat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-webview",
          "title": "pi",
          "icon": "media/icon-mark-128.png"
        }
      ]
    },
    "views": {
      "pi-webview": [
        {
          "type": "webview",
          "id": "piWebview",
          "name": "pi",
          "icon": "media/icon-mark-128.png"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-webview.attachSelection",
        "title": "pi: Attach selection",
        "icon": {
          "light": "media/icon-light.png",
          "dark": "media/icon-dark.png"
        }
      },
      {
        "command": "pi-webview.focus",
        "title": "pi: Open chat",
        "icon": {
          "light": "media/icon-light.png",
          "dark": "media/icon-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-webview.focus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "preinstall": "node tools/check-package-manager.mjs",
    "dev": "node tools/dev.mjs",
    "dev:bridge": "node --watch src/bridge/index.ts --debug",
    "dev:web": "vite",
    "build": "vite build",
    "compile": "node tools/build-extension.mjs",
    "watch:extension": "esbuild src/adapters/vscode/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension/extension.cjs --watch",
    "start": "pnpm build && node src/bridge/index.ts --serve dist/web --open",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "smoke": "node tools/smoke.mjs",
    "package": "pnpm compile && vsce package --out dist/pi-webview.vsix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "package:ide": "node tools/build-ide-vsix.mjs",
    "package:addon": "pnpm package:ide && node tools/build-addon.mjs",
    "release": "node tools/release.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  }
}
