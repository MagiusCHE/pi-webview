<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidPiWebviewPkg">
    <!-- The only entry is in View → Other Windows (IDG_VS_WNDO_OTRWNDWS1):
         the tool window appears there with its icon, exactly like the
         reference ChatGPT extension. No Tools menu clutter: the editor
         selection tracking is automatic (SelectionTracker), there is no
         manual "attach/focus" trigger. -->
    <Buttons>
      <Button guid="guidPiWebviewCmdSet" id="cmdidShowWindow" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidImages" id="bmpIcon" />
        <Strings>
          <ButtonText>pi</ButtonText>
          <CommandName>piWebview.ShowWindow</CommandName>
        </Strings>
      </Button>
    </Buttons>

    <!-- 16x16 PNG icon of the tool window (title bar + Other Windows entry);
         baked into the compiled .cto (Menus.ctmenu resource). -->
    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\icon.png" usedList="bmpIcon" />
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidPiWebviewPkg" value="{7f2e5c1a-3b6d-4e8f-9a2c-1d4e5f6a7b8c}" />
    <GuidSymbol name="guidPiWebviewCmdSet" value="{a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d}">
      <IDSymbol name="cmdidShowWindow" value="0x0100" />
    </GuidSymbol>
    <GuidSymbol name="guidImages" value="{b1e2f3a4-5c6d-4e7f-8a9b-0c1d2e3f4a5b}">
      <IDSymbol name="bmpIcon" value="1" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
