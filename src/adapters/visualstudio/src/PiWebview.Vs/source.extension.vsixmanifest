<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- $version$ is detokenized at build by the VSSDK DetokenizeVsixManifestSource
         task (VsixReplacement item in the csproj): canonical builds pass
         -p:VsixVersion=<package.json version> (tools/build-vs-vsix.mjs) -->
    <Identity Id="PiWebview.Vs.4d433864-8ac9-420a-bc57-700940833fc6" Version="$(version)" Language="en-US" Publisher="pi-webview" />
    <DisplayName>pi</DisplayName>
    <Description xml:space="preserve">Companion Visual Studio di pi-webview: webview dell'agente pi (headless, --mode rpc) integrata nell'IDE. Adapter C# nativo del concept 0005. Nome e icona allineati al companion VS Code.</Description>
    <Icon>icon.png</Icon>
    <Tags>pi;agent;ai;webview</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0, 19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0, 19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <!-- Concrete relative path (pkgdef at the vsix root, see the csproj
         Link on the generated pkgdef): the VSSDK PkgdefProjectOutputGroup
         token (|%CurrentProject%;PkgdefProjectOutputGroup|) is only
         detokenized by the full VS build pipeline (DetokenizeVsixManifestSource);
         the dotnet CLI build leaves it unresolved and VS then cannot find the
         package pkgdef (package silently not registered). Hardcoding the path
         keeps the Linux/wine build deterministic and matches the layout a
         standard Windows build produces. -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="PiWebview.Vs.pkgdef" />
  </Assets>
</PackageManifest>
